# Stage 1: Build the React application
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the app with Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/nginx/html
# Note: If your build outputs to /build instead of /dist, change the path above to /app/build
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]